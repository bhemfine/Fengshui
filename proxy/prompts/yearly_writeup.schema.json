{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstone.app/schemas/yearly_writeup.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "overview", "year_pillar_note", "luck_pillar_note", "tai_sui_note", "home_flying_stars_note", "areas", "quarters", "rule_citations", "disclaimer"],
  "properties": {
    "headline": { "type": "string", "maxLength": 100 },
    "overview": { "type": "string", "maxLength": 1000 },
    "year_pillar_note": { "type": "string", "maxLength": 600 },
    "luck_pillar_note": { "type": "string", "maxLength": 600 },
    "tai_sui_note": { "type": "string", "maxLength": 600 },
    "home_flying_stars_note": { "type": ["string", "null"], "maxLength": 900 },
    "areas": {
      "type": "object", "additionalProperties": false,
      "required": ["career", "money", "health", "love"],
      "properties": {
        "career": { "type": "string", "maxLength": 700 },
        "money": { "type": "string", "maxLength": 700 },
        "health": { "type": "string", "maxLength": 700 },
        "love": { "type": "string", "maxLength": 700 }
      }
    },
    "quarters": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["quarter", "note"],
        "properties": {
          "quarter": { "type": "integer", "minimum": 1, "maximum": 4 },
          "note": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "rule_citations": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule", "source_field"],
        "properties": {
          "rule": { "type": "string", "maxLength": 200 },
          "source_field": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "disclaimer": { "type": "string", "maxLength": 300 }
  }
}
