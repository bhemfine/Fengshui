{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstone.app/schemas/ask_the_master.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "answer", "citations", "safety_flags", "suggest_professional", "suggest_human_master", "follow_up_questions", "disclaimer"],
  "properties": {
    "status": { "type": "string", "enum": ["answered", "partially_answered", "declined_out_of_scope"] },
    "answer": { "type": "string", "maxLength": 2000 },
    "citations": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "detail"],
        "properties": {
          "source": { "type": "string", "maxLength": 200 },
          "detail": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "safety_flags": {
      "type": "array", "maxItems": 6,
      "items": { "type": "string", "enum": ["medical", "legal", "financial", "death_prediction", "self_harm", "minor"] }
    },
    "suggest_professional": { "type": "string", "enum": ["none", "doctor", "lawyer", "financial_adviser", "mental_health_support"] },
    "suggest_human_master": { "type": "boolean" },
    "follow_up_questions": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 200 } },
    "disclaimer": { "type": "string", "maxLength": 300 }
  }
}
