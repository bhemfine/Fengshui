{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstone.app/schemas/palm_reading.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "refusal_reason", "image_quality", "retake_suggested", "hand", "lines", "mounts", "overall_themes", "gentle_advice", "confidence", "disclaimer"],
  "$defs": {
    "conf": { "type": "number", "minimum": 0, "maximum": 1 },
    "line": {
      "type": "object", "additionalProperties": false,
      "required": ["visible", "observations", "interpretation", "confidence"],
      "properties": {
        "visible": { "type": "boolean" },
        "observations": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 300 } },
        "interpretation": { "type": "string", "maxLength": 700 },
        "confidence": { "$ref": "#/$defs/conf" }
      }
    }
  },
  "properties": {
    "status": { "type": "string", "enum": ["ok", "refused"] },
    "refusal_reason": { "type": ["string", "null"], "enum": ["not_a_palm", "face_or_person", "appears_to_be_child", "image_unusable", "other", null] },
    "image_quality": { "type": "string", "enum": ["good", "fair", "poor"] },
    "retake_suggested": { "type": "boolean" },
    "hand": {
      "type": "object", "additionalProperties": false,
      "required": ["which", "shape", "shape_notes"],
      "properties": {
        "which": { "type": "string", "enum": ["left", "right", "unknown"] },
        "shape": { "type": "string", "enum": ["earth", "air", "fire", "water", "unknown"] },
        "shape_notes": { "type": "string", "maxLength": 500 }
      }
    },
    "lines": {
      "type": "object", "additionalProperties": false,
      "required": ["heart", "head", "life", "fate"],
      "properties": {
        "heart": { "$ref": "#/$defs/line" },
        "head": { "$ref": "#/$defs/line" },
        "life": { "$ref": "#/$defs/line" },
        "fate": { "$ref": "#/$defs/line" }
      }
    },
    "mounts": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "prominence", "note"],
        "properties": {
          "name": { "type": "string", "enum": ["venus", "jupiter", "saturn", "apollo", "mercury", "luna", "mars_upper", "mars_lower"] },
          "prominence": { "type": "string", "enum": ["flat", "moderate", "prominent", "unclear"] },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "overall_themes": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 300 } },
    "gentle_advice": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 300 } },
    "confidence": { "$ref": "#/$defs/conf" },
    "disclaimer": { "type": "string", "maxLength": 300 }
  }
}
