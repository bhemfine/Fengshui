{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstone.app/schemas/monthly_writeup.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "overview", "areas", "key_dates_note", "practical_tips", "rule_citations", "disclaimer"],
  "properties": {
    "headline": { "type": "string", "maxLength": 100 },
    "overview": { "type": "string", "maxLength": 800 },
    "areas": {
      "type": "object", "additionalProperties": false,
      "required": ["career", "money", "health", "love"],
      "properties": {
        "career": { "type": "string", "maxLength": 600 },
        "money": { "type": "string", "maxLength": 600 },
        "health": { "type": "string", "maxLength": 600 },
        "love": { "type": "string", "maxLength": 600 }
      }
    },
    "key_dates_note": { "type": ["string", "null"], "maxLength": 400 },
    "practical_tips": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 200 } },
    "rule_citations": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule", "source_field"],
        "properties": {
          "rule": { "type": "string", "maxLength": 200 },
          "source_field": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "disclaimer": { "type": "string", "maxLength": 300 }
  }
}
