{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstone.app/schemas/daily_writeup.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "theme", "lucky_summary", "good_to_do", "better_to_avoid", "body", "rule_citations", "disclaimer"],
  "properties": {
    "headline": { "type": "string", "maxLength": 90 },
    "theme": { "type": "string", "maxLength": 200 },
    "lucky_summary": { "type": "string", "maxLength": 300 },
    "good_to_do": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 160 } },
    "better_to_avoid": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 160 } },
    "body": { "type": "string", "maxLength": 900 },
    "rule_citations": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule", "source_field"],
        "properties": {
          "rule": { "type": "string", "maxLength": 200 },
          "source_field": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "disclaimer": { "type": "string", "maxLength": 200 }
  }
}
